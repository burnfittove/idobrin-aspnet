{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection" : "Server=localhost;Port=3306;Database=aspnetDb;user=dev;",
    "StagingConnection" : "Server=localhost;Port=3306;Database=aspnetStg;user=dev;"
  },
  "AllowedHosts": "*",
  "JWT": {
    "SecureKey": "12345678901234567890123456789012"
  },
  "Serilog": {
    "Using":  [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", 
        "Args": { 
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "_comment": {
    "user1" : {
      "leo" : "leoleoleo"
    },
    "user2" : {
      "mngmnt" : "devdevdev"
    }
  }
}

